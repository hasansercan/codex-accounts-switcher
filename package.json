{
  "name": "codex-accounts-switcher",
  "productName": "Codex Accounts",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "description": "Open-source Codex account switcher for Windows: usage limits, account manager and offline TOTP.",
  "author": {
    "name": "Hasan Sercan",
    "url": "https://github.com/hasansercan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasansercan/codex-accounts-switcher.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test tests/*.test.mjs",
    "build:win": "node scripts/package.mjs",
    "build:installer": "node scripts/installer.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/smoke.mjs --screenshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.0",
    "electron": "45.2.3",
    "tar": "7.5.22",
    "yazl": "3.3.1"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
